# ROFL Paymaster Environment Configuration
# Copy this file to .env and fill in the values

# Configuration
# Path to the configuration YAML file
PAYMASTER_CONFIG_PATH=config.yaml

# Contract Addresses
# Base L2 vault contract address
BASE_VAULT_CONTRACT_ADDRESS=
# Oasis Sapphire paymaster contract address
SAPPHIRE_PAYMASTER_CONTRACT_ADDRESS=
# Blockhash oracle contract address on Sapphire
BLOCKHASH_ORACLE_CONTRACT_ADDRESS=
# Price oracle contract address on Sapphire
PRICE_ORACLE_CONTRACT_ADDRESS=

# Deployment Blocks
# Block number when Base vault contract was deployed
BASE_VAULT_DEPLOYMENT_BLOCK=0
# Block number when Sapphire paymaster was deployed
SAPPHIRE_PAYMASTER_DEPLOYMENT_BLOCK=0
# Block number when blockhash oracle was deployed
BLOCKHASH_ORACLE_DEPLOYMENT_BLOCK=0

# Secrets
# Private key for the paymaster account (0x prefixed hex)
# PAYMASTER_PRIVATE_KEY=
# Base64 encoded encryption key for sensitive data
# PAYMASTER_ENCRYPTION_KEY=

# RPC Configuration
# Comma-separated Base L2 RPC URLs
BASE_RPC_URLS=
# Comma-separated Oasis Sapphire RPC URLs
SAPPHIRE_RPC_URLS=
# Comma-separated Base L2 WebSocket URLs
BASE_WS_URLS=
# Comma-separated Oasis Sapphire WebSocket URLs
SAPPHIRE_WS_URLS=

# Application Settings
# Directory for storing application data
PAYMASTER_DATA_DIR=./data
# Host address for the API server
PAYMASTER_API_HOST=0.0.0.0
# Port for the API server
PAYMASTER_API_PORT=8000

# Logging
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
PAYMASTER_LOG_LEVEL=INFO
# Path to log file (optional)
PAYMASTER_LOG_FILE=

# Development
# Enable debug mode (true/false)
PAYMASTER_DEBUG=false
# Enable test mode with mock contracts (true/false)
PAYMASTER_TEST_MODE=false
