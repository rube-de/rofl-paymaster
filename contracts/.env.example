# Alchemy API Key for Base Mainnet Archive Node
# Get your API key from https://www.alchemy.com/
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Private key for deployments (optional, uses test mnemonic if not provided)
PRIVATE_KEY=your_private_key_here

# Custom RPC URLs (optional, defaults are provided)
BASE_SEPOLIA_RPC=https://sepolia.base.org
SAPPHIRE_TESTNET_RPC=https://testnet.sapphire.oasis.dev

# --- CrossChainPaymaster deployment ---
# Owner and Operator addresses
OWNER=0xOwnerAddress
OPERATOR=0xOperatorAddress

# External contracts
PRICE_ORACLE=0xOracleAddress
SHOYU_BASHI=0xShoyuBashiAddress

# Distribution limits (ROSE units)
DAILY_LIMIT_ROSE=10000
PER_TX_LIMIT_ROSE=100
LIMITS_ENABLED=true

# --- Upgrade script ---
PROXY_ADDRESS=0xProxyToUpgrade
RUN_VALIDATION=true
